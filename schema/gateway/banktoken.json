{
  "openapi": "3.1.0",
  "info": {
    "title": "platform-api",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://www.speedchex.com/datalinks/transact.aspx"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "sec0": []
    }
  ],
  "paths": {
    "/?createtoken": {
      "post": {
        "summary": "Create bank token",
        "description": "",
        "operationId": "banktoken",
        "parameters": [
          {
            "name": "ProviderID",
            "in": "query",
            "description": "Your Platform ID as provided by ACHQ",
            "required": true,
            "schema": {
              "type": "string",
              "default": "99"
            }
          },
          {
            "name": "Provider_GateKey",
            "in": "query",
            "description": "Provided by ACHQ",
            "required": true,
            "schema": {
              "type": "string",
              "default": "test"
            }
          },
          {
            "name": "Provider_GateID",
            "in": "query",
            "description": "Provided by ACHQ",
            "required": true,
            "schema": {
              "type": "string",
              "default": "test"
            }
          },
          {
            "name": "MerchantID",
            "in": "query",
            "description": "Unique identifier for your customer. Provided by ACHQ",
            "required": true,
            "schema": {
              "type": "string",
              "default": "2001"
            }
          },
          {
            "name": "Merchant_GateID",
            "in": "query",
            "description": "Gateway ID for you customer. Provided by ACHQ",
            "required": true,
            "schema": {
              "type": "string",
              "default": "test"
            }
          },
          {
            "name": "Merchant_GateKey",
            "in": "query",
            "description": "API Key for you customer. Provided by ACHQ",
            "required": true,
            "schema": {
              "type": "string",
              "default": "test"
            }
          },
          {
            "name": "CommandVersion",
            "in": "query",
            "description": "Use a value of 2.0 for this API version",
            "required": true,
            "schema": {
              "type": "string",
              "default": "2.0"
            }
          },
          {
            "name": "Command",
            "in": "query",
            "description": "Use value ECheck.CreateACHQToken",
            "schema": {
              "type": "string",
              "default": "ECheck.CreateACHQToken"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "CheckType",
                  "AccountType"
                ],
                "properties": {
                  "Provider_TransactionID": {
                    "type": "string",
                    "description": "An external ID which can be used for traceability between your application and ACHQ",
                    "default": "21321312"
                  },
                  "CheckType": {
                    "type": "string",
                    "description": "Personal or Business",
                    "default": "Personal"
                  },
                  "AccountType": {
                    "type": "string",
                    "description": "Checking or Savings",
                    "default": "Checking"
                  },
                  "RoutingNumber": {
                    "type": "string",
                    "description": "Bank routing number",
                    "default": "123123123"
                  },
                  "AccountNumber": {
                    "type": "string",
                    "description": "Bank account number",
                    "default": "123456789"
                  }
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": []
      }
    }
  },
  "x-readme": {
    "headers": [],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
