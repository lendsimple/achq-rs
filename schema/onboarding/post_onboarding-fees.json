              "schema": {
                "$ref": "#/components/schemas/CreateFeeRequest"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/CreateFeeRequest"
              }
            },
            "text/xml": {
              "schema": {
                "$ref": "#/components/schemas/CreateFeeRequest"
              }
            },
            "application/*+xml": {
              "schema": {
                "$ref": "#/components/schemas/CreateFeeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CreateFeeResponse"
