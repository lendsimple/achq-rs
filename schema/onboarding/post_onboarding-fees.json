{
  "openapi": "3.0.1",
  "info": {
    "title": "SpeedchexOnboarding",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://www.speedchex.com/api"
    }
  ],
  "paths": {
    "/onboarding/fees": {
      "post": {
        "tags": [
          "Onboarding"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFeeRequest"
              }
            },
            "text/json": {
