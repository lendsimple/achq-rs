  "components": {
    "schemas": {
      "CreateFeeRequest": {
        "type": "object",
        "properties": {
          "feeName": {
            "type": "string",
            "description": "Friendly name for this fee profile",
            "nullable": true
          },
          "monthlyFee": {
            "type": "number",
            "description": "Monthly service fee",
            "format": "double",
            "nullable": true
          },
          "transactionFee": {
            "type": "number",
            "description": "Dollar amount fee to be assessed for each transaction",
            "format": "double",
            "nullable": true
          },
          "returnFee": {
            "type": "number",
            "description": "Dollar amount fee to be assessed for each returned transaction",
            "format": "double",
            "nullable": true
          },
          "disputeFee": {
            "type": "number",
            "description": "Dollar amount fee to be assessed for each disputed transaction",
            "format": "double",
            "nullable": true
          },
          "percentFee": {
            "type": "number",
            "description": "Percentage fee to be assessed on the dollar amount of each transaction",
            "format": "double",
            "nullable": true
          },
          "percentCap": {
            "type": "number",
            "description": "Max dollar amount to be assessed for a “percentFee” charge.",
            "format": "double",
            "nullable": true
          },
          "bankStatusFee": {
            "type": "number",
            "description": "Dollar amount fee to be assessed for each “BankStatus” verification",
            "format": "double",
            "nullable": true
          },
          "bankIdFee": {
            "type": "number",
            "description": "Dollar amount fee to be assessed for each “BankID” verification",
            "format": "double",
            "nullable": true
          },
          "setupFee": {
            "type": "number",
            "description": "Dollar amount fee to be charged if merchant account is activate",
            "format": "double",
            "nullable": true
          },
          "metaData": {
            "type": "string",
            "description": "Free-form key-value pair list that can be added to an account. Useful for storing account information that is not captured elsewhere.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateFeeResponse": {
        "type": "object",
        "properties": {
          "feeProfileId": {
            "type": "string",
            "description": "Fee Profile Id",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Status",
            "nullable": true
          },
          "apiRequestId": {
            "type": "string",
            "nullable": true
          },
          "apiRequestTimeStamp": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "additionalInformation": {
            "type": "string",
            "nullable": true
          },
          "apiRequestId": {
            "type": "string",
            "nullable": true
          },
          "apiRequestTimeStamp": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "ProviderID": {
        "type": "apiKey",
        "description": "ProviderID needed to access the endpoints.",
        "name": "ProviderID",
        "in": "header"
      },
      "Provider_GateID": {
        "type": "apiKey",
        "description": "Provider_GateID needed to access the endpoints.",
        "name": "Provider_GateID",
        "in": "header"
      },
      "Provider_GateKey": {
        "type": "apiKey",
        "description": "Provider_GateKey needed to access the endpoints.",
        "name": "Provider_GateKey",
        "in": "header"
      }
    }
  },
  "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
  }
